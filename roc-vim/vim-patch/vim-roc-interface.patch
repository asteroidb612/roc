diff --git a/src/if_roc.c b/src/if_roc.c
new file mode 100644
index 0000000..7e8d9d9
--- /dev/null
+++ b/src/if_roc.c
@@ -0,0 +1,414 @@
+/* vi:set ts=8 sts=4 sw=4 noet:
+ *
+ * VIM - Vi IMproved	by Bram Moolenaar
+ *
+ * Do ":help uganda"  in Vim to read copying and usage conditions.
+ * Do ":help credits" in Vim to see a list of people who contributed.
+ * See README.txt for an overview of the Vim source code.
+ */
+
+/*
+ * if_roc.c: Roc plugins, loaded into Vim's own process.
+ *
+ * A Roc plugin is a shared library built by the Roc compiler. It holds the
+ * compiled plugin together with the platform host that connects it to Vim.
+ * Vim loads it with dlopen(), hands it a table of functions to call back
+ * into, and calls it when something happens.
+ *
+ * Everything that crosses the boundary is text: Vim's own syntax for commands
+ * and expressions, and JSON for values. That keeps this interface independent
+ * of how the Roc compiler lays out its types.
+ *
+ * The functions this adds:
+ *	roc_load({path})		load a plugin, returns a handle
+ *	roc_event({handle}, {name} [, {data}])	tell a plugin something happened
+ *	roc_unload({handle})		unload a plugin
+ */
+
+#include "vim.h"
+
+#if defined(FEAT_ROC) || defined(PROTO)
+
+# include <dlfcn.h>
+
+/*
+ * The table of Vim functions a plugin may call. A plugin checks
+ * roc_vim_abi_version() before using it; the version changes whenever this
+ * struct does.
+ */
+#define ROC_VIM_ABI_VERSION 1
+
+typedef struct roc_vim_api roc_vim_api_T;
+struct roc_vim_api
+{
+    int		abi_version;
+
+    // Run an Ex command, as though it were typed after a colon.
+    void	(*ex)(const char *cmd, size_t len);
+
+    // Evaluate a Vim expression and return its value as JSON text, or NULL if
+    // it could not be evaluated. Free the result with free_result().
+    char	*(*eval_json)(const char *expr, size_t len, size_t *out_len);
+
+    // Free something eval_json() returned.
+    void	(*free_result)(char *ptr);
+
+    // Show a message, as :echomsg does, or as an error when is_error is set.
+    void	(*message)(const char *text, size_t len, int is_error);
+};
+
+typedef struct
+{
+    void	*lib;		// dlopen() handle, NULL for a free slot
+    char_u	*path;
+    int		busy;		// inside a call into this plugin
+
+    int		(*plugin_init)(const roc_vim_api_T *api, int handle);
+    char	*(*plugin_event)(const char *json, size_t len, size_t *out_len);
+    void	(*plugin_free)(char *ptr);
+    void	(*plugin_deinit)(void);
+} roc_plugin_T;
+
+#define ROC_MAX_PLUGINS 64
+
+static roc_plugin_T roc_plugins[ROC_MAX_PLUGINS];
+
+/*
+ * Return the plugin for a handle, or NULL when there is none.
+ */
+    static roc_plugin_T *
+roc_plugin_by_handle(int handle)
+{
+    if (handle < 1 || handle > ROC_MAX_PLUGINS)
+	return NULL;
+    if (roc_plugins[handle - 1].lib == NULL)
+	return NULL;
+    return &roc_plugins[handle - 1];
+}
+
+/*
+ * Copy len bytes and NUL-terminate them, so they can go into functions that
+ * expect a string. Returns NULL when out of memory.
+ */
+    static char_u *
+roc_copy_nul_terminated(const char *bytes, size_t len)
+{
+    char_u *copy = alloc(len + 1);
+
+    if (copy == NULL)
+	return NULL;
+    if (len > 0)
+	mch_memmove(copy, bytes, len);
+    copy[len] = NUL;
+    return copy;
+}
+
+/*
+ * The plugin side of the API: what a plugin can ask Vim to do.
+ */
+    static void
+roc_api_ex(const char *cmd, size_t len)
+{
+    char_u *copy = roc_copy_nul_terminated(cmd, len);
+
+    if (copy == NULL)
+	return;
+    do_cmdline_cmd(copy);
+    vim_free(copy);
+}
+
+    static char *
+roc_api_eval_json(const char *expr, size_t len, size_t *out_len)
+{
+    char_u	*copy;
+    typval_T	*result;
+    char_u	*encoded;
+    char	*answer = NULL;
+
+    if (out_len != NULL)
+	*out_len = 0;
+    copy = roc_copy_nul_terminated(expr, len);
+    if (copy == NULL)
+	return NULL;
+
+    result = eval_expr(copy, NULL);
+    vim_free(copy);
+    if (result == NULL)
+	return NULL;
+
+    encoded = json_encode(result, 0);
+    free_tv(result);
+    if (encoded == NULL)
+	return NULL;
+
+    // Hand back memory from the C allocator, which is what free_result()
+    // gives back; the plugin's own allocator is none of Vim's business.
+    {
+	size_t encoded_len = STRLEN(encoded);
+
+	answer = (char *)malloc(encoded_len + 1);
+	if (answer != NULL)
+	{
+	    mch_memmove(answer, encoded, encoded_len + 1);
+	    if (out_len != NULL)
+		*out_len = encoded_len;
+	}
+	vim_free(encoded);
+    }
+    return answer;
+}
+
+    static void
+roc_api_free_result(char *ptr)
+{
+    free(ptr);
+}
+
+    static void
+roc_api_message(const char *text, size_t len, int is_error)
+{
+    char_u *copy = roc_copy_nul_terminated(text, len);
+
+    if (copy == NULL)
+	return;
+    if (is_error)
+	emsg((char *)copy);
+    else
+    {
+	// What :echomsg does: show it and keep it in the message history.
+	msg_attr((char *)copy, 0);
+	out_flush();
+    }
+    vim_free(copy);
+}
+
+static const roc_vim_api_T roc_api =
+{
+    ROC_VIM_ABI_VERSION,
+    roc_api_ex,
+    roc_api_eval_json,
+    roc_api_free_result,
+    roc_api_message,
+};
+
+/*
+ * Unload one plugin, giving it a chance to clean up first.
+ */
+    static void
+roc_unload_plugin(roc_plugin_T *plugin)
+{
+    if (plugin->lib == NULL)
+	return;
+    if (plugin->plugin_deinit != NULL && !plugin->busy)
+	plugin->plugin_deinit();
+    dlclose(plugin->lib);
+    plugin->lib = NULL;
+    VIM_CLEAR(plugin->path);
+    plugin->busy = FALSE;
+    plugin->plugin_init = NULL;
+    plugin->plugin_event = NULL;
+    plugin->plugin_free = NULL;
+    plugin->plugin_deinit = NULL;
+}
+
+/*
+ * Unload every plugin. Called when Vim exits.
+ */
+    void
+roc_end(void)
+{
+    int i;
+
+    for (i = 0; i < ROC_MAX_PLUGINS; ++i)
+	roc_unload_plugin(&roc_plugins[i]);
+}
+
+/*
+ * "roc_load({path})": load a Roc plugin, returning a handle to it.
+ * Returns 0 if it could not be loaded.
+ */
+    void
+f_roc_load(typval_T *argvars, typval_T *rettv)
+{
+    char_u		*path;
+    void		*lib;
+    int			slot;
+    roc_plugin_T	*plugin;
+    int			(*abi_version)(void);
+    int			started;
+
+    rettv->v_type = VAR_NUMBER;
+    rettv->vval.v_number = 0;
+
+    if (check_for_string_arg(argvars, 0) == FAIL)
+	return;
+    path = tv_get_string(&argvars[0]);
+
+    for (slot = 0; slot < ROC_MAX_PLUGINS; ++slot)
+	if (roc_plugins[slot].lib == NULL)
+	    break;
+    if (slot == ROC_MAX_PLUGINS)
+    {
+	emsg(_(e_too_many_roc_plugins));
+	return;
+    }
+
+    lib = dlopen((char *)path, RTLD_NOW | RTLD_LOCAL);
+    if (lib == NULL)
+    {
+	semsg(_(e_could_not_load_roc_plugin_str), dlerror());
+	return;
+    }
+
+    abi_version = (int (*)(void))dlsym(lib, "roc_vim_abi_version");
+    if (abi_version == NULL || abi_version() != ROC_VIM_ABI_VERSION)
+    {
+	dlclose(lib);
+	semsg(_(e_roc_plugin_str_was_built_for_another_vim), path);
+	return;
+    }
+
+    plugin = &roc_plugins[slot];
+    plugin->lib = lib;
+    plugin->path = vim_strsave(path);
+    plugin->busy = FALSE;
+    plugin->plugin_init = (int (*)(const roc_vim_api_T *, int))
+						dlsym(lib, "roc_vim_plugin_init");
+    plugin->plugin_event = (char *(*)(const char *, size_t, size_t *))
+						dlsym(lib, "roc_vim_plugin_event");
+    plugin->plugin_free = (void (*)(char *))dlsym(lib, "roc_vim_plugin_free");
+    plugin->plugin_deinit = (void (*)(void))dlsym(lib, "roc_vim_plugin_deinit");
+
+    if (plugin->plugin_init == NULL || plugin->plugin_event == NULL)
+    {
+	roc_unload_plugin(plugin);
+	semsg(_(e_roc_plugin_str_is_missing_its_entry_points), path);
+	return;
+    }
+
+    plugin->busy = TRUE;
+    started = plugin->plugin_init(&roc_api, slot + 1);
+    plugin->busy = FALSE;
+    if (started != 0)
+    {
+	roc_unload_plugin(plugin);
+	semsg(_(e_roc_plugin_str_failed_to_start), path);
+	return;
+    }
+
+    rettv->vval.v_number = slot + 1;
+}
+
+/*
+ * "roc_event({handle}, {name} [, {data}])": tell a plugin that something
+ * happened, and return whatever it answers.
+ */
+    void
+f_roc_event(typval_T *argvars, typval_T *rettv)
+{
+    roc_plugin_T	*plugin;
+    dict_T		*message;
+    typval_T		message_tv;
+    char_u		*json;
+    char		*answer;
+    size_t		answer_len = 0;
+
+    rettv->v_type = VAR_NUMBER;
+    rettv->vval.v_number = 0;
+
+    if (check_for_number_arg(argvars, 0) == FAIL
+	    || check_for_string_arg(argvars, 1) == FAIL)
+	return;
+
+    plugin = roc_plugin_by_handle((int)tv_get_number(&argvars[0]));
+    if (plugin == NULL)
+    {
+	emsg(_(e_no_such_roc_plugin));
+	return;
+    }
+    if (plugin->busy)
+    {
+	// The plugin is already running: it is holding its own state, so
+	// calling in again would hand it state it is in the middle of using.
+	semsg(_(e_roc_plugin_str_is_already_running), plugin->path);
+	return;
+    }
+
+    message = dict_alloc();
+    if (message == NULL)
+	return;
+    if (dict_add_string(message, "event", tv_get_string(&argvars[1])) == FAIL)
+    {
+	dict_unref(message);
+	return;
+    }
+    if (argvars[2].v_type != VAR_UNKNOWN)
+    {
+	typval_T copy;
+
+	copy_tv(&argvars[2], &copy);
+	if (dict_add_tv(message, "data", &copy) == FAIL)
+	    clear_tv(&copy);
+    }
+
+    message_tv.v_type = VAR_DICT;
+    message_tv.vval.v_dict = message;
+    json = json_encode(&message_tv, 0);
+    dict_unref(message);
+    if (json == NULL)
+	return;
+
+    plugin->busy = TRUE;
+    answer = plugin->plugin_event((char *)json, STRLEN(json), &answer_len);
+    plugin->busy = FALSE;
+    vim_free(json);
+
+    if (answer != NULL)
+    {
+	js_read_T   reader;
+	char_u	    *answer_copy = roc_copy_nul_terminated(answer, answer_len);
+
+	if (plugin->plugin_free != NULL)
+	    plugin->plugin_free(answer);
+	if (answer_copy != NULL)
+	{
+	    reader.js_buf = answer_copy;
+	    reader.js_fill = NULL;
+	    reader.js_used = 0;
+	    if (json_decode(&reader, rettv, 0) == FAIL)
+	    {
+		rettv->v_type = VAR_NUMBER;
+		rettv->vval.v_number = 0;
+	    }
+	    vim_free(answer_copy);
+	}
+    }
+}
+
+/*
+ * "roc_unload({handle})": unload a plugin. Returns 1 when one was unloaded.
+ */
+    void
+f_roc_unload(typval_T *argvars, typval_T *rettv)
+{
+    roc_plugin_T *plugin;
+
+    rettv->v_type = VAR_NUMBER;
+    rettv->vval.v_number = 0;
+
+    if (check_for_number_arg(argvars, 0) == FAIL)
+	return;
+
+    plugin = roc_plugin_by_handle((int)tv_get_number(&argvars[0]));
+    if (plugin == NULL)
+	return;
+    if (plugin->busy)
+    {
+	semsg(_(e_roc_plugin_str_is_already_running), plugin->path);
+	return;
+    }
+    roc_unload_plugin(plugin);
+    rettv->vval.v_number = 1;
+}
+
+#endif // FEAT_ROC
