# Built by the platforms' build.sh: the host libraries and the C runtime pieces
# Roc links alongside them.
/platform/targets/
/platform-inprocess/targets/

# Compiled plugins (the sources are the interesting part).
/examples/*
!/examples/*.roc
/examples-inprocess/*
!/examples-inprocess/*.roc
# ...but the vimrc example is more than one file: the Vimscript it still needs,
# a README explaining the split, and a directory of its own, because a plugin
# can be main.roc plus the modules it imports.
!/examples-inprocess/*.vim
!/examples-inprocess/README.md
!/examples-inprocess/*/
!/examples-inprocess/*/*.roc

# Where the two build scripts clone and build Vim and Roc.
/vim-patch/build/
/compiler-patch/build/

# The engine library and the compiler library it is built from: ~340MB of
# build output, made by embed/build.sh.
/embed/*.so
/embed/*.a

# `roc build examples/<name>.roc` from this directory leaves the binary here.
/hello

# Generated by :helptags
/vim/doc/tags

# Python bytecode from running the tests
__pycache__/
