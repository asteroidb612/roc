# Built by the platforms' build.sh: the host libraries and the C runtime pieces
# Roc links alongside them.
/platform/targets/
/platform-inprocess/targets/

# Compiled plugins (the sources are the interesting part).
/examples/*
!/examples/*.roc
/examples-inprocess/*
!/examples-inprocess/*.roc

# Where vim-patch/build-vim.sh clones and builds Vim.
/vim-patch/build/

# The engine library and the compiler library it is built from: ~340MB of
# build output, made by embed/build.sh.
/embed/*.so
/embed/*.a

# Generated by :helptags
/vim/doc/tags

# Python bytecode from running the tests
__pycache__/
